# Copy this file to .env and fill in the values. NEVER commit .env (it is gitignored).
# These are the key NAMES the engine reads; values are intentionally left blank.

ANTHROPIC_API_KEY=

# Optional stage-specific overrides. Defaults are in code.
SCORER_MODEL=
IDEAS_MODEL=
AUDIT_MODEL=
VERIFY_MODEL=
WRITER_MODEL=

# Optional reproducible end date for Wikipedia demand windows (YYYY-MM-DD).
WIKIPEDIA_END_DATE=
